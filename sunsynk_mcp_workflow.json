          ]
        },
        "options": {}
      },
      "id": "22222222-0006-0006-0006-000000000006",
      "name": "Fetch Realtime (Battery)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 60]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data || {};\nreturn [{ json: {\n  battery_soc: d.soc,\n  battery_power_w: d.battPower,\n  battery_voltage_v: d.battVolt,\n  battery_current_a: d.battCurrent,\n  battery_temperature_c: d.batteryTemperature,\n  charging: (d.battPower || 0) > 0,\n  timestamp: new Date().toISOString()\n}}];"
      },
      "id": "22222222-0007-0007-0007-000000000007",
      "name": "Shape Battery Response",
