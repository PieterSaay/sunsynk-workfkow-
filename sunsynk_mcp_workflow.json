      "typeVersion": 4.2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data || {};\nreturn [{ json: {\n  pv_power_w: d.pvPower,\n  battery_power_w: d.battPower,\n  grid_power_w: d.gridOrMeterPower,\n  load_power_w: d.loadOrEpsPower,\n  grid_importing: (d.gridOrMeterPower || 0) > 0,\n  grid_voltage_v: d.gridVoltage,\n  grid_frequency_hz: d.gridFrequency,\n  timestamp: new Date().toISOString()\n}}];"
      },
